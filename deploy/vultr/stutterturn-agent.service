[Unit]
Description=StutterTurn recorded-source replay API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stutterturn
Group=stutterturn
WorkingDirectory=/opt/stutterturn/current
EnvironmentFile=/opt/stutterturn/shared/agent.env
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=HF_HOME=/opt/stutterturn/shared/cache
ExecStart=/opt/stutterturn/venv/bin/python agent/server.py --services on --port 8765 --max-runs 1 --allowed-origin https://64-177-51-1.sslip.io
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/stutterturn/shared
UMask=0077
MemoryHigh=650M
MemoryMax=800M
TasksMax=64

[Install]
WantedBy=multi-user.target
