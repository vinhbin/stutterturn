# Copy to agent/.env and fill in. agent/.env is gitignored; never commit real keys.
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ElevenLabs: profile (bottom-left) -> API Keys, with Text to Speech permission
ELEVENLABS_API_KEY=
# Optional: an ElevenLabs voice id; empty uses the agent's default voice
ELEVENLABS_VOICE_ID=
